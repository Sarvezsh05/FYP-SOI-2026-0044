# Filess.io CloudVault hosted MySQL configuration
# Copy to .env and set DB_PASSWORD privately on the EC2 instance.
# NEVER connect the deliberately vulnerable lab to a hosted database.
PORT=3000
API_PORT=8000
HOST=127.0.0.1
LAB_MODE=false
USE_MYSQL=true
STORAGE_MODE=local

DB_HOST=YOUR_HOSTED_MYSQL_HOST
DB_PORT=3307
DB_NAME=YOUR_HOSTED_MYSQL_DATABASE_OR_USERNAME
DB_USER=YOUR_HOSTED_MYSQL_DATABASE_OR_USERNAME
DB_PASSWORD=REPLACE_ON_SERVER
DB_SSL=true
