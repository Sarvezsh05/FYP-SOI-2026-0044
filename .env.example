# Protected website by default (no pre-created accounts). Run scripts/create-admin.js to create John123.
# To test vulnerabilities instead, use a SEPARATE local LAB_MODE=true installation with dummy SQLite.
PORT=3000
API_PORT=8000
HOST=127.0.0.1
LAB_MODE=false
USE_MYSQL=false
STORAGE_MODE=local

# Connect MySQL later: execute db/cloudvault_mysql.sql first,
# then install only the optional database package: npm.cmd install mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cloudvault
DB_PASSWORD=your_password_here
DB_NAME=cloudvault_db

# Protected AWS S3 is ONLY for LAB_MODE=false; requires npm install @aws-sdk/client-s3
AWS_REGION=ap-southeast-1
S3_BUCKET=your-private-bucket-name

# API_KEY and SESSION_SECRET are automatically generated locally if omitted.
# For production set unique values as secure environment variables.

# Set true ONLY when using HTTPS (e.g., a trusted TLS reverse proxy).
COOKIE_SECURE=false

# For actual email password recovery in protected mode, configure SMTP and install nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://127.0.0.1:3000
