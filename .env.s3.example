# Protected CloudVault on EC2 with MySQL metadata and private S3 file bytes.
# Use only on an EC2 instance without the deliberately vulnerable lab.
HOST=127.0.0.1
PORT=3000
API_PORT=8000
LAB_MODE=false
USE_MYSQL=true
STORAGE_MODE=s3
AWS_REGION=ap-southeast-1
S3_BUCKET=REPLACE_PRIVATE_BUCKET_NAME

DB_HOST=REPLACE_HOSTED_MYSQL_HOST
DB_PORT=3306
DB_NAME=REPLACE_MYSQL_DB_NAME
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_SSL=true

# Leave false when using localhost over an SSH tunnel.
# Turn on only after configuring HTTPS correctly.
COOKIE_SECURE=false

# Optional: real email password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
